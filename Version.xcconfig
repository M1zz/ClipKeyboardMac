// Version Configuration
// 이 파일에서 Mac 앱의 버전을 중앙 관리합니다.
// fastlane bump 레인이 CURRENT_PROJECT_VERSION 을 +1 합니다.

// 마케팅 버전 (App Store에 표시되는 버전)
MARKETING_VERSION = 5.0.5

// 빌드 번호 (내부 버전)
// ⚠️ 전역 단조 증가. 마케팅 버전이 올라가도 리셋하면 안 된다.
//    4.4.7(1)로 리셋했다가 "must contain a higher version than [13]"으로 업로드 거절됨.
//    그래서 4.4.8 도 (1)이 아니라 14 다음인 15 로 갔다.
//    (마케팅 버전을 4.4.8 에서 5.0.3 으로 건너뛴 것은 아이폰 앱과 번호를 맞추기 위해서다)
//    이후로는 마케팅 버전과 무관하게 그냥 +1 이다:
//    5.0.3(16) → 5.0.4(17) → 5.0.5(18) → 5.0.5(19)
// ⚠️ 18 은 이미 업로드됐다가 거절된 번호다 (Guideline 2.4.5 — 접근성 API 오용).
//    그래서 접근성 제거판은 19 로 나간다.
//    같은 번호로 다시 올리면 거절된다:
//    "must contain a higher version than that of the previously uploaded version [18]".
//    올리기 전에 App Store Connect 의 최신 빌드 번호를 보고 그보다 큰 값인지 확인할 것.
CURRENT_PROJECT_VERSION = 19
