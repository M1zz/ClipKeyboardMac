        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 단축어의 내용은 아이폰에서만 바꿀 수 있습니다. 여기서는 제목·카테고리만 수정돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
