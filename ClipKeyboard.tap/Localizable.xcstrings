        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已複製 [%@] 到剪貼板"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复制 [%@] 到剪贴板"
          }
        }
      }
    },
    "{ }로 감싸면 입력할 때 채우는 칸이 됩니다" : {
      "comment" : "Custom placeholder hint",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrap text in { } to make a fill-in field"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{ }로 감싸면 입력할 때 채우는 칸이 됩니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 { } 包起來，輸入時就會變成填空欄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 { } 包起来，输入时就会变成填空栏"
          }
        }
      }
    },
