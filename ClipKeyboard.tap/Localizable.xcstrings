    "'%@'이(가) 이 맥과 동기화된 기기에서 사라집니다." : {
      "comment" : "Delete confirm message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úryvek „%@“ bude odstraněn z tohoto Macu i ze všech synchronizovaných zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« fjernes fra denne Mac og alle synkroniserede enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird von diesem Mac und allen synchronisierten Geräten entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το απόσπασμα «%@» θα αφαιρεθεί από αυτό το Mac και από κάθε συγχρονισμένη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' will be removed from this Mac and every synced device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se eliminará de este Mac y de todos los dispositivos sincronizados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” poistetaan tästä Macista ja kaikista synkronoiduista laitteista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé de ce Mac et de tous les appareils synchronisés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” akan dihapus dari Mac ini dan semua perangkat yang disinkronkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà rimosso da questo Mac e da tutti i dispositivi sincronizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はこのMacと同期しているすべてのデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'이(가) 이 맥과 동기화된 기기에서 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» fjernes fra denne Macen og alle synkroniserte enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ wordt verwijderd van deze Mac en van alle gesynchroniseerde apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragment „%@” zostanie usunięty z tego Maca i ze wszystkich synchronizowanych urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
