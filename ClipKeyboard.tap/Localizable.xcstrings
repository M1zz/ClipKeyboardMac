    "이 기기에 단축어 %d개가 있습니다. 복구하면 지금의 단축어가 백업 시점의 것으로 모두 교체됩니다." : {
      "comment" : "Restore would replace local data warning",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úryvky na tomto Macu: %d. Obnovení je všechny nahradí úryvky ze zálohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac har %d tekststykker. Ved gendannelse erstattes de alle af dem fra sikkerhedskopien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac sind %d Textbausteine. Beim Wiederherstellen werden sie alle durch die aus dem Backup ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το Mac έχει %d αποσπάσματα. Η επαναφορά θα τα αντικαταστήσει όλα με εκείνα του αντιγράφου ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac has %d shortcuts. Restoring replaces all of them with the ones from the backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac tiene %d fragmentos. Al restaurar, todos se reemplazan por los de la copia de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä Macissa on %d tekstinpätkää. Palauttaminen korvaa ne kaikki varmuuskopion tekstinpätkillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac contient %d extraits. La restauration les remplace tous par ceux de la sauvegarde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini punya %d cuplikan. Memulihkan akan mengganti semuanya dengan isi cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo Mac ci sono %d frammenti. Il ripristino li sostituisce tutti con quelli del backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにはスニペットが%d件あります。復元すると、すべてバックアップの内容に置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 단축어 %d개가 있습니다. 복구하면 지금의 단축어가 백업 시점의 것으로 모두 교체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Macen har %d tekstbiter. Ved gjenoppretting erstattes alle med dem fra sikkerhetskopien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac bevat %d fragmenten. Bij het terugzetten worden ze allemaal vervangen door die uit de reservekopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmenty na tym Macu: %d. Przywrócenie zastąpi je wszystkie fragmentami z kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac tem %d trechos. Restaurar substitui todos eles pelos do backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac заготовок: %d. При восстановлении все они будут заменены заготовками из резервной копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Macen har %d textsnuttar. Vid återställning ersätts alla med dem från säkerhetskopian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac เครื่องนี้มีข้อความ %d รายการ การกู้คืนจะแทนที่ทั้งหมดด้วยข้อความจากข้อมูลสำรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te %d hazır metin var. Geri yükleme, hepsini yedekteki hazır metinlerle değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac này có %d đoạn văn bản. Khi khôi phục, tất cả sẽ được thay bằng nội dung trong bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上有 %d 个快捷词。恢复后，当前的快捷词将全部替换为备份时的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上有 %d 個快捷詞。回復後，目前的快捷詞將全部取代為備份時的內容。"
          }
        }
      }
    },
    "이 기기의 단축어가 %2$d개뿐이라 %1$d개짜리 기존 백업을 덮어쓰지 않았습니다." : {
      "comment" : "Backup skipped body",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto zařízení je jen tento počet úryvků: %2$d, proto stávající záloha (%1$d) zůstala beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed har kun %2$d tekststykker, så den eksisterende sikkerhedskopi med %1$d blev ikke rørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät sind nur %2$d Textbausteine, daher wurde das vorhandene Backup mit %1$d nicht angetastet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή έχει μόνο %2$d αποσπάσματα, γι’ αυτό το υπάρχον αντίγραφο ασφαλείας με %1$d έμεινε ανέγγιχτο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has only %2$d shortcuts, so the existing backup of %1$d was left untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo solo tiene %2$d fragmentos, así que no se tocó la copia existente de %1$d."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä laitteessa on vain %2$d tekstinpätkää, joten nykyiseen varmuuskopioon (%1$d) ei koskettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne contient que %2$d extraits : la sauvegarde existante de %1$d n’a donc pas été touchée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini hanya punya %2$d cuplikan, jadi cadangan lama berisi %1$d tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo ci sono solo %2$d frammenti, quindi il backup esistente di %1$d non è stato toccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにはスニペットが%2$d件しかないため、%1$d件の既存バックアップはそのまま残しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 단축어가 %2$d개뿐이라 %1$d개짜리 기존 백업을 덮어쓰지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten har bare %2$d tekstbiter, så den eksisterende sikkerhetskopien med %1$d ble ikke rørt."
          }
