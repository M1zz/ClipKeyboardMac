    "기본·즐겨찾기 같은 탭이 아이폰과 같아집니다. 단축어는 그대로 있어요." : {
      "comment" : "Category parity prompt detail",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panely jako Obecné a Oblíbené budou vypadat stejně jako na iPhonu. Vaše úryvky zůstanou tam, kde jsou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faner som Generelt og Favoritter kommer til at se ud præcis som på iPhone. Dine tekststykker bliver, hvor de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs wie „Allgemein“ und „Favoriten“ sehen dann genauso aus wie auf dem iPhone. Deine Textbausteine bleiben, wo sie sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καρτέλες όπως Γενικά και Αγαπημένα θα φαίνονται ακριβώς όπως στο iPhone. Τα αποσπάσματά σας μένουν εκεί που είναι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs like General and Favorites will look just like they do on iPhone. Your snippets stay exactly where they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas como General y Favoritos se verán igual que en el iPhone. Tus fragmentos se quedan donde están."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilehdet, kuten Yleiset ja Suosikit, näyttävät silloin täsmälleen samoilta kuin iPhonessa. Tekstinpätkäsi pysyvät paikallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets comme Général et Favoris apparaîtront exactement comme sur l’iPhone. Vos extraits restent où ils sont."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab seperti Umum dan Favorit akan tampil persis seperti di iPhone. Cuplikan Anda tetap di tempatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede come Generale e Preferiti appariranno esattamente come su iPhone. I tuoi frammenti restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「一般」や「お気に入り」などのタブがiPhoneと同じ並びになります。スニペットそのものは動きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본·즐겨찾기 같은 탭이 아이폰과 같아집니다. 단축어는 그대로 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faner som Generelt og Favoritter vil da se ut akkurat som på iPhone. Tekstbitene dine blir der de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladen zoals Algemeen en Favorieten zien er dan precies zo uit als op je iPhone. Je fragmenten blijven gewoon waar ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty takie jak Ogólne i Ulubione będą wyglądać tak samo jak na iPhonie. Twoje fragmenty zostaną na swoich miejscach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abas como Geral e Favoritos vão ficar iguaizinhas às do iPhone. Seus trechos continuam onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки «Общее» и «Избранное» будут выглядеть так же, как на iPhone. Ваши заготовки останутся на своих местах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flikar som Allmänt och Favoriter ser då ut precis som på iPhone. Dina textsnuttar stannar där de är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แท็บอย่าง ทั่วไป และ รายการโปรด จะเหมือนกับบน iPhone ทุกประการ ข้อความของคุณยังอยู่ที่เดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel ve Favoriler gibi sekmeler iPhone’dakiyle aynı görünecek. Hazır metinleriniz oldukları yerde kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tab như Chung và Mục ưa thích sẽ hiển thị giống hệt trên iPhone. Đoạn văn bản của bạn vẫn ở nguyên chỗ cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“基本”“收藏”等标签页会和 iPhone 上完全一致。你的短语不会有任何变动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「基本」「收藏」等標籤頁會和 iPhone 上完全一致。你的短語不會有任何變動。"
          }
        }
      }
    },
    "기존 백업(단축어 %1$d개)을 %2$d개로 덮어쓰려고 합니다. 줄어든 데이터는 백업에서 사라집니다." : {
      "comment" : "Backup would reduce data warning",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stávající záloha (úryvky: %1$d) by se přepsala zálohou s počtem úryvků %2$d. Rozdíl by ze zálohy zmizel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din eksisterende sikkerhedskopi med %1$d tekststykker ville blive overskrevet med %2$d. Forskellen ville forsvinde fra sikkerhedskopien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein vorhandenes Backup mit %1$d Textbausteinen würde mit %2$d überschrieben. Die Differenz ginge im Backup verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το υπάρχον αντίγραφο ασφαλείας με %1$d αποσπάσματα θα αντικατασταθεί από ένα με %2$d. Η διαφορά θα χαθεί από το αντίγραφο ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This would overwrite your existing backup of %1$d shortcuts with %2$d. The difference would be gone from the backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu copia de seguridad de %1$d fragmentos se sobrescribiría con %2$d. La diferencia desaparecería de la copia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen varmuuskopio (%1$d tekstinpätkää) korvattaisiin uudella (%2$d tekstinpätkää). Erotus katoaisi varmuuskopiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sauvegarde existante de %1$d extraits serait remplacée par %2$d. La différence disparaîtrait de la sauvegarde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan Anda yang berisi %1$d cuplikan akan ditimpa dengan %2$d. Selisihnya akan hilang dari cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup esistente di %1$d frammenti verrebbe sovrascritto con %2$d. La differenza sparirebbe dal backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペット%1$d件の既存バックアップを%2$d件で上書きしようとしています。減った分はバックアップから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 백업(단축어 %1$d개)을 %2$d개로 덮어쓰려고 합니다. 줄어든 데이터는 백업에서 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den eksisterende sikkerhetskopien med %1$d tekstbiter ville blitt overskrevet med %2$d. Differansen ville forsvunnet fra sikkerhetskopien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt je bestaande reservekopie van %1$d fragmenten overschreven met %2$d. Het verschil zou uit de reservekopie verdwijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejąca kopia zapasowa (fragmenty: %1$d) zostałaby nadpisana kopią z liczbą fragmentów %2$d. Różnica zniknęłaby z kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu backup atual de %1$d trechos seria substituído por um de %2$d. A diferença sumiria do backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В резервной копии сейчас заготовок: %1$d, после перезаписи останется: %2$d. Разница пропадёт из резервной копии."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din befintliga säkerhetskopia med %1$d textsnuttar skulle skrivas över med %2$d. Skillnaden skulle försvinna från säkerhetskopian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองเดิมที่มีข้อความ %1$d รายการจะถูกเขียนทับด้วย %2$d รายการ ส่วนที่หายไปจะไม่อยู่ในข้อมูลสำรองอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, %1$d hazır metin içeren mevcut yedeğinizin üzerine %2$d hazır metin yazar. Aradaki fark yedekten silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
