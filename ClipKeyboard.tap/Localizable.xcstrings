    "'%@'와 일치하는 항목이 없습니다" : {
      "comment" : "No results for search query",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No items match '%@'"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'와 일치하는 항목이 없습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有與「%@」相符的項目"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有与“%@”匹配的项目"
          }
        }
      }
    },
    "'%@'이(가) 이 맥과 동기화된 기기에서 사라집니다." : {
      "comment" : "Delete confirm message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' will be removed from this Mac and every synced device."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'이(가) 이 맥과 동기화된 기기에서 사라집니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將從這台 Mac 和所有已同步的裝置中移除。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从这台 Mac 和所有已同步的设备中移除。"
          }
        }
      }
    },
    "[%@] 클립보드에 복사되었습니다" : {
      "comment" : "Clipboard copy toast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[%@] copied to clipboard"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[%@] 클립보드에 복사되었습니다"
