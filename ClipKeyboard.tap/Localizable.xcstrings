    "요청이 너무 많습니다. 잠시 후 다시 시도해주세요." : {
      "comment" : "Rate limited error message",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho požadavků. Zkuste to prosím za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange anmodninger. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen. Bitte versuch es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλά αιτήματα. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests. Please try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Inténtalo de nuevo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta pyyntöä. Yritä hetken päästä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de requêtes. Réessayez dans un instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppe richieste. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストが多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 너무 많습니다. 잠시 후 다시 시도해주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forespørsler. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verzoeken. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele żądań. Spróbuj ponownie za moment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitações demais. Tente de novo daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много запросов. Повторите попытку чуть позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många förfrågningar. Försök igen om en stund."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีคำขอมากเกินไป โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok fazla istek var. Lütfen biraz sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều yêu cầu. Vui lòng thử lại sau ít phút."
