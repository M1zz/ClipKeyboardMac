          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заготовка «%@» будет удалена с этого Mac и со всех синхронизированных устройств."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
